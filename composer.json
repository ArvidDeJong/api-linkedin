{
    "name": "darvis/api-linkedin",
    "description": "Universal Laravel integration for publishing posts on LinkedIn (personal profile and company page) through OAuth 2.0 and the Posts API.",
    "keywords": [
        "laravel",
        "linkedin",
        "oauth",
        "posts-api",
        "social",
        "share",
        "laravel-boost"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/ArvidDeJong/api-linkedin",
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "info@arvid.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/ArvidDeJong/api-linkedin/issues",
        "source": "https://github.com/ArvidDeJong/api-linkedin"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Darvis\\ApiLinkedin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\ApiLinkedin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\ApiLinkedin\\LinkedInServiceProvider"
            ],
            "aliases": {
                "LinkedIn": "Darvis\\ApiLinkedin\\Facades\\LinkedIn"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
